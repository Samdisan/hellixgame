    "time_constraints": {
      "min_elapsed_sec": 900,
      "max_elapsed_sec": 9900
    },
    "actions": [
      {"type": "set_subphase_state", "subphase_id": "SP_BATTLE_FOR_LIFE", "state": "active"},
      {"type": "push_terminal", "target": "both", "level": "warning", "message": "[SUBPHASE] Битва за життя активна."}
    ]
