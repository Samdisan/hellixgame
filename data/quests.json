    "actions": [
      {"type": "push_terminal", "target": "admin_terminal", "level": "info", "message": "PH_INTRO активовано. Моніторинг часу розпочато."}
    ]
  },
  {
    "id": "Q_INTRO_ARRIVAL",
    "label": "Підфаза 1.1: Прибуття",
    "phase": "PH_INTRO",
    "description": "Станція фіксує прибуття експедицій та оголошує підготовку секторів.",
    "time_constraints": {
      "min_elapsed_sec": 300,
      "max_elapsed_sec": 900
    },
    "actions": [
      {"type": "set_subphase_state", "subphase_id": "SP_INTRO_ARRIVAL", "state": "active"},
      {"type": "push_terminal", "target": "public_terminal", "level": "info", "message": "Прибуття експедицій."},
      {"type": "push_terminal", "target": "admin_terminal", "level": "info", "message": "[INTEL] Прибуття експедицій підтверджено."},
      {"type": "deactivate_protocol", "protocol_id": "PR_I1"},
      {"type": "deactivate_protocol", "protocol_id": "PR_I2"}
    ]
  },
  {
    "id": "Q_START_OUTBREAK",
    "label": "Старт PH_OUTBREAK",
    "phase": "PH_INTRO",
    "description": "Автоматичний перехід до OUTBREAK після планових 15 хвилин.",
    "time_constraints": {
      "min_elapsed_sec": 900
    },
    "actions": [
      {"type": "set_phase", "to": "PH_OUTBREAK"}
    ]
  },
  {
    "id": "Q_OUTBREAK_START",
    "label": "PH_OUTBREAK активна",
    "phase": "PH_OUTBREAK",
    "description": "Початок фази перших симптомів.",
    "actions": [
      {"type": "push_terminal", "target": "both", "level": "warning", "message": "PH_OUTBREAK: система фіксує нестабільність."}
    ]
  },
  {
    "id": "Q_OUTBREAK_END",
    "label": "Завершення PH_OUTBREAK",
    "phase": "PH_OUTBREAK",
    "description": "Ручне або сценарне завершення фази.",
    "actions": [
      {"type": "push_terminal", "target": "admin_terminal", "level": "info", "message": "PH_OUTBREAK завершено."}
    ]
  },
  {
    "id": "Q_ORIGIN_START",
    "label": "Відновити код Origin",
    "phase": "PH_OUTBREAK",
    "subphase_id": "SP_ORIGIN_RECOVERY",
    "description": "Запускає критичну підфазу Origin.",
    "time_constraints": {
      "min_elapsed_sec": 900,
      "max_elapsed_sec": 14400
    },
    "actions": [
      {"type": "set_subphase_state", "subphase_id": "SP_ORIGIN_RECOVERY", "state": "active"},
      {"type": "push_terminal", "target": "both", "level": "warning", "message": "[SUBPHASE] Розпочато відновлення коду Origin."}
    ]
  },
  {
    "id": "Q_ORIGIN_SUCCESS",
    "label": "Origin: успіх",
    "phase": "PH_OUTBREAK",
    "subphase_id": "SP_ORIGIN_RECOVERY",
    "description": "Успішне відновлення коду Origin.",
    "actions": [
      {"type": "set_subphase_state", "subphase_id": "SP_ORIGIN_RECOVERY", "state": "success"},
      {"type": "push_terminal", "target": "both", "level": "info", "message": "[SUBPHASE] Origin відновлено."}
    ]
  },
  {
    "id": "Q_ORIGIN_FAIL",
    "label": "Origin: провал",
    "phase": "PH_OUTBREAK",
    "subphase_id": "SP_ORIGIN_RECOVERY",
    "description": "Провал підфази Origin.",
    "actions": [
      {"type": "set_subphase_state", "subphase_id": "SP_ORIGIN_RECOVERY", "state": "fail"},
      {"type": "push_terminal", "target": "both", "level": "critical", "message": "[SUBPHASE] Origin втраченo. Перехід до карантину рекомендовано."}
    ]
  },
  {
    "id": "Q_BATTLE_FOR_LIFE_START",
    "label": "Битва за життя",
    "phase": "PH_OUTBREAK",
    "subphase_id": "SP_BATTLE_FOR_LIFE",
